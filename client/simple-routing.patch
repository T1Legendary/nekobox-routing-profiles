diff --git a/src/nekobox/dataStore/SimpleRuleClassification.hpp b/src/nekobox/dataStore/SimpleRuleClassification.hpp
new file mode 100644
index 0000000..0b48548
--- /dev/null
+++ b/src/nekobox/dataStore/SimpleRuleClassification.hpp
@@ -0,0 +1,42 @@
+#pragma once
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+// UI metadata only. Never split, merge or reorder the imported rules.
+namespace SimpleRuleClassification {
+enum Kind { Custom = 0, Address = 1, ProcessName = 2, ProcessPath = 3 };
+enum Action { Direct = 0, Block = 1, Proxy = 2 };
+struct Result { Kind kind = Custom; Action action = Direct; };
+
+inline Kind selectorKind(std::string_view key) {
+    if (key == "domain" || key == "domain_suffix" || key == "domain_keyword" ||
+        key == "domain_regex" || key == "ip_cidr" || key == "rule_set") return Address;
+    if (key == "process_name") return ProcessName;
+    if (key == "process_path") return ProcessPath;
+    return Custom;
+}
+
+inline Result classify(const std::vector<std::string>& keys, std::string_view action,
+                       int outbound, bool selectorsValid) {
+    if (!selectorsValid) return {};
+    Kind kind = Custom;
+    bool hasOutbound = false;
+    for (const auto& key : keys) {
+        if (key == "action") continue;
+        if (key == "outbound") { hasOutbound = true; continue; }
+        const auto next = selectorKind(key);
+        // Unknown fields and additional conditions stay in the advanced editor.
+        if (next == Custom || (kind != Custom && kind != next)) return {};
+        kind = next;
+    }
+    if (kind == Custom) return {};
+    if (action == "reject" && !hasOutbound) return {kind, Block};
+    if (action != "route" || !hasOutbound) return {};
+    if (outbound == -2) return {kind, Direct};
+    if (outbound == -1) return {kind, Proxy};
+    if (outbound == -3) return {kind, Block};
+    return {};
+}
+}
